{
  "files": [],
  "references": [
    {
      "path": "./config/tsconfig.main.json"
    },
    {
      "path": "./config/tsconfig.preload.json"
    },
    {
      "path": "./config/tsconfig.renderer.json"
    },
    {
      "path": "./config/tsconfig.scripts.json"
    }
  ],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  }
}
